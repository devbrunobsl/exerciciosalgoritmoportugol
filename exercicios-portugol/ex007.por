programa
{
	
	funcao inicio()
	{
		escreva("======DOBRO E TERCEIRA PARTE====== \n")
		real num, dobro, terco
		escreva("Digite um número: ")
		leia(num)
		dobro = num * 2
		terco = num / 3
		escreva("O dobro de ", num, " é ", dobro, " e sua terceira parte é ", terco)
	}
}
