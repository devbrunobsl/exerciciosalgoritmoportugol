programa
{
	
	funcao inicio()
	{
		escreva("======ANTECESSOR E SUCESSOR====== \n")
		inteiro num, a, s
		escreva("Digite um número: ")
		leia(num)
		a = num - 1
		s = num + 1
		escreva("Seu antecessor é ", a, " e seu sucessor é ", s)
	}
}
