programa
{
	
	funcao inicio()
	{
		escreva("======TIPOS DE DISTÂNCIA====== \n")
		real metros, km, hm, dam, dm, cm, mm
		escreva("Digite uma distância em metros: ")
		leia(metros)
		km = metros / 1000
		hm = metros / 100
		dam = metros / 10
		dm = metros * 10
		cm = metros * 100
		mm = metros * 1000
		escreva("A distância de 85.7m corresponde a: \n")
		escreva(km, "km \n")
		escreva(hm, "hm \n")
		escreva(dam, "dam \n")
		escreva(dm, "dm \n")
		escreva(cm, "cm \n")
		escreva(mm, "mm \n")
	}
}
