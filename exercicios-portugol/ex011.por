programa
{
	
	funcao inicio()
	{
		escreva("======CALCULO VALOR DE DELTA====== \n")
		inteiro A, B, C, delta
		escreva("Valor de A: ")
		leia(A)
		escreva("Valor de B: ")
		leia(B)
		escreva("Valor de C: ")
		leia(C)
		delta = B^2 - 4 * A * C
		escreva("O valor de delta é ", delta)
	}
}
