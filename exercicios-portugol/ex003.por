programa
{
	
	funcao inicio()
	{
		escreva("======FICHA DE FUNCIONÁRIO====== \n")
		cadeia nome
		real sal
		escreva("Nome do Funcionário: ")
		leia(nome)
		escreva("Salário: R$")
		leia(sal)
		escreva("O funcionário ", nome, " tem um salário de R$", sal)
	}
}
