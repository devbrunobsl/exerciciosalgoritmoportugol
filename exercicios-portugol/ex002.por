programa
{
	
	funcao inicio()
	{
		escreva("======APRESENTAÇÃO====== \n")
		cadeia nome
		escreva("Olá, qual o seu nome? ")
		leia(nome)
		escreva("Olá, ", nome, ", é um prazer te conhecer!")
	}
}
