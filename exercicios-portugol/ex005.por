programa
{
	
	funcao inicio()
	{
		escreva("======BOLETIM====== \n")
		cadeia aluno
		real nota1, nota2, media
		escreva("Nome do aluno: ")
		leia(aluno)
		escreva("Nota 1: ")
		leia(nota1)
		escreva("Nota 2: ")
		leia(nota2)
		media = (nota1 + nota2) / 2
		escreva("A nota média de ", aluno, " é ", media)
	}
}
